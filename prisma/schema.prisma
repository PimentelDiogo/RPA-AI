// Schema do portal SheepContabil.
//
// Este arquivo tem duas camadas:
//
//   1. O núcleo do portal — pessoas, permissão e execução. Vale para todos os
//      módulos: quem entrou, quem disparou o quê, quando, com que resultado.
//   2. O domínio compartilhado — o cliente da contabilidade, sobre o qual todas
//      as automações operam.
//
// Cada automação acrescenta suas próprias tabelas na branch do seu módulo.
// O catálogo de módulos NÃO é tabela: vive em código (src/modules/catalogo.ts),
// porque é o registro do que foi implementado, não um dado que a operação edita.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Pessoas e permissão
// ---------------------------------------------------------------------------

/// Perfis exigidos pelo enunciado: o administrador enxerga tudo, o operador
/// enxerga apenas os módulos da área dele.
enum Perfil {
  ADMIN
  OPERADOR
}

/// Setores da SheepContabil que aparecem no catálogo de processos. É por aqui
/// que se decide quais módulos um operador enxerga.
enum Area {
  CONTABIL
  FISCAL
  PROCESSOS
  DEPARTAMENTO_PESSOAL
  SOCIETARIO
  TECNOLOGIA
  ATENDIMENTO
  BPO_SAUDE
}

model Usuario {
  id           String   @id @default(cuid())
  email        String   @unique
  nome         String
  /// Hash argon2id. Senha em claro não existe em lugar nenhum do sistema.
  senhaHash    String
  perfil       Perfil   @default(OPERADOR)
  /// Áreas que o operador enxerga. Ignorado para ADMIN, que enxerga tudo.
  areas        Area[]   @default([])
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  execucoes  Execucao[]
  conferidos Lancamento[]

  @@map("usuario")
}

// ---------------------------------------------------------------------------
// Domínio compartilhado
// ---------------------------------------------------------------------------

/// Cliente da contabilidade. Massa 100% sintética: CNPJ fictício, válido apenas
/// em formato. Todas as automações operam sobre esta base.
model Cliente {
  id           String   @id @default(cuid())
  /// Somente dígitos, 14 posições.
  cnpj         String   @unique
  razaoSocial  String
  nomeFantasia String?
  municipio    String
  uf           String   @db.Char(2)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  certificados Certificado[]
  contatos     ContatoAviso[]
  situacoes    SituacaoFiscal[]
  tentativas   ConsultaTentativa[]
  extratos     ExtratoImportado[]
  bloqueio     BloqueioCliente?
  sagas        SagaBloqueio[]
  financeiro   RegistroFinanceiro?
  acessoPortal AcessoPortalCliente?
  tarefas      TarefaCliente[]

  @@index([razaoSocial])
  @@map("cliente")
}

// ---------------------------------------------------------------------------
// Execução — o núcleo que todo módulo reaproveita
// ---------------------------------------------------------------------------

/// Como a execução começou. O enunciado exige as duas: sob demanda e sozinha,
/// na frequência que o catálogo indica.
enum Disparo {
  MANUAL
  AGENDADO
}

enum StatusExecucao {
  EM_EXECUCAO
  SUCESSO
  /// Terminou, mas com itens que falharam. Distinguir isso de SUCESSO é o que
  /// impede uma consulta que falhou de sumir do painel.
  SUCESSO_PARCIAL
  FALHA
}

/// Uma rodada de um módulo. Responde as quatro perguntas que o enunciado cobra
/// do histórico: quando, quanto durou, quem disparou e qual foi o resultado.
model Execucao {
  id     String @id @default(cuid())
  /// Código do catálogo: SC-01, SC-02, SC-05, SC-20. Referencia o módulo
  /// declarado em código, não uma tabela.
  modulo String

  disparo Disparo
  status  StatusExecucao @default(EM_EXECUCAO)

  iniciadaEm   DateTime  @default(now())
  finalizadaEm DateTime?
  /// Duração em milissegundos, gravada no fim. Redundante com as datas de
  /// propósito: a listagem do histórico ordena e filtra por ela sem recalcular.
  duracaoMs    Int?

  /// Nulo quando o disparo foi agendado — nesse caso não há pessoa por trás.
  disparadoPor   Usuario? @relation(fields: [disparadoPorId], references: [id], onDelete: SetNull)
  disparadoPorId String?

  /// Mensagem para o operador ler, em português e sem jargão. Stack trace, se
  /// houver, vai em detalheTecnico — nunca na tela como causa.
  erro           String?
  detalheTecnico String?

  /// Resumo que o módulo escreve para a listagem ("42 certificados, 3 avisos").
  resumo String?

  itens ExecucaoItem[]

  @@index([modulo, iniciadaEm(sort: Desc)])
  @@index([status])
  @@map("execucao")
}

enum StatusItem {
  SUCESSO
  FALHA
  /// Não foi possível concluir e o item precisa de olho humano antes de seguir.
  CONFERENCIA
  IGNORADO
}

/// O item a item de uma execução. É o que permite dizer *o que* falhou dentro
/// de uma rodada que, no geral, funcionou.
model ExecucaoItem {
  id         String   @id @default(cuid())
  execucao   Execucao @relation(fields: [execucaoId], references: [id], onDelete: Cascade)
  execucaoId String

  /// Identificação legível do item na tela: nome do cliente, órgão, arquivo.
  referencia String
  status     StatusItem
  /// Mensagem legível quando o item não terminou bem.
  mensagem   String?
  /// Dados específicos do módulo sobre este item.
  dados      Json?

  registradoEm DateTime @default(now())

  @@index([execucaoId])
  @@map("execucao_item")
}

enum TipoArtefato {
  ARQUIVO
  TABELA
  REGISTRO_DE_ENVIO
}

/// A saída visível que o enunciado exige: arquivo para download, tabela ou o
/// registro do que foi enviado.
model Artefato {
  id         String @id @default(cuid())
  execucaoId String

  tipo     TipoArtefato
  nome     String
  mimeType String?
  /// Caminho no FileStorage quando o artefato é arquivo.
  caminho  String?
  /// Conteúdo quando o artefato é tabela ou registro de envio.
  conteudo Json?
  criadoEm DateTime     @default(now())

  @@index([execucaoId])
  @@map("artefato")
}

// ---------------------------------------------------------------------------
// Agendamento — as automações rodam sem ninguém logado
// ---------------------------------------------------------------------------

/// Agenda de um módulo. O tick do agendador lê esta tabela, decide o que está
/// vencido e enfileira. Uma linha por módulo agendável.
model Agendamento {
  id     String @id @default(cuid())
  modulo String @unique

  /// Expressão de frequência em cron, no fuso America/Sao_Paulo.
  cron  String
  ativo Boolean @default(true)

  ultimaExecucaoEm  DateTime?
  proximaExecucaoEm DateTime?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("agendamento")
}

// ---------------------------------------------------------------------------
// SC-20 — Vencimento de certificado digital
// Projeto do módulo em SDD/SC-20/SDD.md
// ---------------------------------------------------------------------------

enum TipoCertificado {
  A1
  A3
}

/// Faixas do painel. Existem como enum, e não como cálculo solto na tela,
/// porque a régua de avisos compara faixas entre execuções: é a mudança de
/// faixa que dispara um aviso novo, não a passagem do tempo.
enum FaixaVencimento {
  VENCIDO
  ATE_15
  ATE_30
  ATE_60
}

model Certificado {
  id        String  @id @default(cuid())
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId String

  /// Quem responde pelo certificado — é a pessoa que precisa ser acionada.
  titular    String
  tipo       TipoCertificado
  emissor    String
  /// Só a data importa; hora não existe em vencimento de certificado.
  validade   DateTime        @db.Date
  observacao String?
  /// Certificado renovado fica inativo, não some: o histórico de avisos
  /// continua fazendo sentido.
  ativo      Boolean         @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  avisos AvisoCertificado[]

  @@index([clienteId])
  @@index([validade])
  @@map("certificado")
}

/// Quem é avisado. O destinatário é interno: o enunciado pede aviso "para quem
/// precisa acionar o cliente", não para o cliente.
model ContatoAviso {
  id        String  @id @default(cuid())
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId String

  nome  String
  email String
  ativo Boolean @default(true)

  criadoEm DateTime @default(now())

  avisos AvisoCertificado[]

  @@index([clienteId])
  @@map("contato_aviso")
}

/// A régua de avisos.
///
/// Guarda o que foi comunicado e o que foi deliberadamente calado. A supressão
/// é registro de primeira classe: sem ela ninguém sabe se o sistema não avisou
/// porque decidiu não repetir, ou porque falhou.
model AvisoCertificado {
  id            String      @id @default(cuid())
  certificado   Certificado @relation(fields: [certificadoId], references: [id], onDelete: Cascade)
  certificadoId String

  /// Nulo quando é registro de supressão: não houve destinatário.
  contato   ContatoAviso? @relation(fields: [contatoId], references: [id], onDelete: SetNull)
  contatoId String?

  /// Qual rodada gerou este registro.
  execucaoId String?

  /// É esta faixa que a execução seguinte compara para decidir se algo mudou.
  /// Guardar só a data do último aviso não responde "mudou alguma coisa?".
  faixa         FaixaVencimento
  /// Congelado no momento do aviso: dias restantes mudam todo dia.
  diasRestantes Int

  /// A mensagem exata que foi (ou seria) enviada. Como nada sai da aplicação,
  /// esta coluna é o próprio outbox mostrado no portal.
  conteudo String

  registradoEm    DateTime @default(now())
  suprimido       Boolean  @default(false)
  motivoSupressao String?

  @@index([certificadoId, registradoEm(sort: Desc)])
  @@index([suprimido])
  @@map("aviso_certificado")
}

/// Configuração do módulo. Linha única: a janela de alerta é regra de negócio
/// que a operação ajusta, não constante de código.
model ConfiguracaoSc20 {
  id String @id @default("unica")

  /// Quantos dias antes do vencimento o certificado entra no painel e na régua.
  janelaDias Int @default(60)

  atualizadoEm DateTime @updatedAt

  @@map("configuracao_sc20")
}

// ---------------------------------------------------------------------------
// SC-02 — Painel de situação fiscal dos clientes
// Projeto do módulo em SDD/SC-02/SDD.md
// ---------------------------------------------------------------------------

enum OrgaoConsultado {
  RECEITA_FEDERAL
  FGTS
  PREVIDENCIA
  FAZENDA_ESTADUAL
}

enum SituacaoApurada {
  REGULAR
  IRREGULAR
  /// O órgão respondeu, mas disse que não pode informar agora. Diferente de
  /// "não conseguimos perguntar", que não é situação — é ausência de leitura.
  INDISPONIVEL
}

/// Como a consulta foi feita. Aparece no painel para que a origem do dado seja
/// rastreável: cliente HTTP ou robô de navegador.
enum OrigemConsulta {
  HTTP
  PLAYWRIGHT
}

/// A última leitura **bem-sucedida** de cada par cliente × órgão.
///
/// Existe separada de `ConsultaTentativa` por causa da armadilha que o
/// enunciado registra neste processo: consulta que falhou não pode sumir, e
/// falha nenhuma sobrescreve o que se sabia antes. Com uma tabela só, ninguém
/// distinguiria "o cliente está irregular" de "o robô não conseguiu perguntar".
model SituacaoFiscal {
  id        String          @id @default(cuid())
  cliente   Cliente         @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId String
  orgao     OrgaoConsultado

  situacao SituacaoApurada
  detalhe  String?

  /// Quando esta leitura foi obtida. É o que permite mostrar a idade do dado —
  /// "regular há 2 dias" diz mais do que "regular", e a planilha de hoje
  /// "nasce vencida" justamente por não ter isso.
  apuradaEm DateTime
  origem    OrigemConsulta

  atualizadoEm DateTime @updatedAt

  @@unique([clienteId, orgao])
  @@index([situacao])
  @@map("situacao_fiscal")
}

/// Toda tentativa de consulta, a que deu certo e a que não.
///
/// É o registro que o enunciado cobra: "guarde a tentativa, o erro e a hora".
model ConsultaTentativa {
  id        String          @id @default(cuid())
  cliente   Cliente         @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId String
  orgao     OrgaoConsultado

  execucaoId String?

  /// 1, 2, 3 — a mesma consulta é retentada com espera crescente.
  tentativa Int
  sucesso   Boolean

  situacao      SituacaoApurada?
  /// Mensagem legível para o operador quando não deu certo.
  erro          String?
  /// O que o órgão devolveu. Guardado para quando a resposta vier num formato
  /// inesperado e alguém precisar entender o que aconteceu.
  respostaBruta String?

  origem     OrigemConsulta
  duracaoMs  Int
  iniciadaEm DateTime       @default(now())

  @@index([clienteId, orgao, iniciadaEm(sort: Desc)])
  @@index([sucesso])
  @@map("consulta_tentativa")
}

// ---------------------------------------------------------------------------
// SC-01 — Conversão de extrato bancário para OFX
// Projeto do módulo em SDD/SC-01/SDD.md
// ---------------------------------------------------------------------------

/// Como os lançamentos foram lidos. Aparece na tela porque muda o que se pode
/// esperar do resultado: parser reconhece um layout conhecido, IA interpreta.
enum OrigemLeitura {
  PARSER
  IA
}

/// Confiança de um lançamento. É o que decide o que entra direto no OFX e o
/// que vai para a fila de conferência antes de virar contabilidade.
enum ConfiancaLancamento {
  ALTA
  MEDIA
  BAIXA
}

enum StatusExtrato {
  /// Recebido e ainda não processado — é a fila que o agendador varre.
  RECEBIDO
  PROCESSADO
  FALHOU
}

/// Arquivo guardado pelo port `FileStorage`.
///
/// Fica em tabela própria de propósito: é infraestrutura, não domínio. O
/// adapter real (S3, Vercel Blob) substitui esta tabela sem que o módulo saiba.
model ArquivoArmazenado {
  id       String   @id @default(cuid())
  chave    String   @unique
  nome     String
  mimeType String
  tamanho  Int
  conteudo Bytes
  criadoEm DateTime @default(now())

  @@map("arquivo_armazenado")
}

model ExtratoImportado {
  id         String  @id @default(cuid())
  cliente    Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId  String
  execucaoId String?

  arquivoNome  String
  arquivoChave String
  /// Reconhece reenvio do mesmo arquivo e evita lançamento duplicado.
  arquivoHash  String @unique

  banco   String?
  agencia String?
  conta   String?

  competenciaInicio DateTime? @db.Date
  competenciaFim    DateTime? @db.Date
  saldoInicial      Decimal?  @db.Decimal(14, 2)
  saldoFinal        Decimal?  @db.Decimal(14, 2)

  origemLeitura OrigemLeitura?
  /// Qual parser reconheceu o layout. Nulo quando a leitura foi por IA.
  parserUsado   String?

  status StatusExtrato @default(RECEBIDO)
  /// Mensagem legível quando o extrato não pôde ser convertido.
  erro   String?

  /// Diferença entre saldo inicial + lançamentos e o saldo final. Zero é o que
  /// autoriza gerar o OFX; qualquer outro valor é motivo para não gerar.
  diferencaSaldo Decimal? @db.Decimal(14, 2)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  lancamentos Lancamento[]

  @@index([clienteId, criadoEm(sort: Desc)])
  @@index([status])
  @@map("extrato_importado")
}

model Lancamento {
  id        String           @id @default(cuid())
  extrato   ExtratoImportado @relation(fields: [extratoId], references: [id], onDelete: Cascade)
  extratoId String

  /// Ordem em que aparece no extrato — o OFX preserva a sequência original.
  ordem     Int
  data      DateTime @db.Date
  historico String
  /// Negativo é débito. O sinal é parte do dado, não uma coluna à parte.
  valor     Decimal  @db.Decimal(14, 2)

  confianca         ConfiancaLancamento
  /// Por que este lançamento caiu na fila. Obrigatório quando não é ALTA.
  motivoConferencia String?

  conferido      Boolean   @default(false)
  conferidoPor   Usuario?  @relation(fields: [conferidoPorId], references: [id], onDelete: SetNull)
  conferidoPorId String?
  conferidoEm    DateTime?

  @@index([extratoId, ordem])
  @@index([confianca])
  @@map("lancamento")
}

// ---------------------------------------------------------------------------
// SC-05 — Bloqueio e desbloqueio de clientes inadimplentes
// Projeto do módulo em SDD/SC-05/SDD.md
// ---------------------------------------------------------------------------

enum EstadoBloqueio {
  LIVRE
  BLOQUEADO
  /// A sequência parou no meio: parte dos sistemas foi alterada, parte não.
  /// É o estado que o processo manual produz sem ninguém perceber, e que aqui
  /// fica visível e pede decisão.
  PARCIAL
  REVERTENDO
}

enum DirecaoSaga {
  BLOQUEIO
  DESBLOQUEIO
}

enum StatusPasso {
  PENDENTE
  APLICADO
  FALHOU
  COMPENSADO
}

/// Estado consolidado do cliente. Uma linha por cliente.
model BloqueioCliente {
  id        String  @id @default(cuid())
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId String  @unique

  estado EstadoBloqueio @default(LIVRE)
  motivo String?

  bloqueadoEm    DateTime?
  desbloqueadoEm DateTime?
  atualizadoEm   DateTime  @updatedAt

  @@map("bloqueio_cliente")
}

/// Uma execução da sequência, num sentido ou no outro.
///
/// O desbloqueio não é outra rotina: é a **mesma** saga com direção invertida,
/// compensando os passos na ordem contrária.
model SagaBloqueio {
  id         String  @id @default(cuid())
  cliente    Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId  String
  execucaoId String?

  direcao   DirecaoSaga
  motivo    String
  concluida Boolean     @default(false)

  criadaEm     DateTime  @default(now())
  finalizadaEm DateTime?

  passos PassoSaga[]

  @@index([clienteId, criadaEm(sort: Desc)])
  @@map("saga_bloqueio")
}

model PassoSaga {
  id     String       @id @default(cuid())
  saga   SagaBloqueio @relation(fields: [sagaId], references: [id], onDelete: Cascade)
  sagaId String

  ordem   Int
  sistema String
  acao    String
  status  StatusPasso @default(PENDENTE)
  /// Mensagem legível quando o passo não deu certo.
  erro    String?

  /// O que existia antes do passo ser aplicado. É o que permite desfazer para
  /// o estado real, e não para um estado inventado — sem isto o desbloqueio
  /// devolveria todas as tarefas para um responsável padrão.
  estadoAnterior Json?

  iniciadoEm  DateTime?
  concluidoEm DateTime?

  @@index([sagaId, ordem])
  @@map("passo_saga")
}

// ---------------------------------------------------------------------------
// Os três sistemas simulados. Cada um tem estado próprio e visível no portal —
// é assim que a tela mostra "não sobrou sistema sem bloqueio".
// ---------------------------------------------------------------------------

/// Sistema financeiro: marca a inadimplência.
model RegistroFinanceiro {
  id           String    @id @default(cuid())
  cliente      Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId    String    @unique
  inadimplente Boolean   @default(false)
  marcadoEm    DateTime?
  atualizadoEm DateTime  @updatedAt

  @@map("fake_registro_financeiro")
}

/// Portal do cliente: acesso liberado ou revogado.
model AcessoPortalCliente {
  id           String    @id @default(cuid())
  cliente      Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId    String    @unique
  ativo        Boolean   @default(true)
  revogadoEm   DateTime?
  atualizadoEm DateTime  @updatedAt

  @@map("fake_acesso_portal")
}

/// Sistema de tarefas.
///
/// **O cliente nunca é desativado aqui.** O que muda é o responsável de cada
/// tarefa, que passa a ser o marcador de bloqueado — e o responsável original
/// fica guardado, por tarefa, porque a maioria dos clientes renegocia depois e
/// recriar o histórico dá mais trabalho.
model TarefaCliente {
  id        String  @id @default(cuid())
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId String

  titulo              String
  responsavel         String
  /// Preenchido enquanto o cliente está bloqueado; nulo quando não está.
  responsavelOriginal String?
  concluida           Boolean @default(false)

  atualizadoEm DateTime @updatedAt

  @@index([clienteId])
  @@map("fake_tarefa_cliente")
}

/// Interruptor de falha dos sistemas simulados.
///
/// Existe para a demonstração de falha parcial não depender de sorte: liga-se
/// a falha num sistema, dispara-se o bloqueio, e a saga para no meio.
model FalhaSimulada {
  id      String  @id @default(cuid())
  sistema String  @unique
  falhar  Boolean @default(false)

  atualizadoEm DateTime @updatedAt

  @@map("fake_falha_simulada")
}
