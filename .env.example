# Copie para .env e ajuste. O .env não é versionado.
# Este arquivo é a documentação do ambiente: toda variável nova entra aqui.

# --- Banco ------------------------------------------------------------------
# Local: o docker-compose deste repositório (porta 5433 no host, para não
# esbarrar em outro Postgres na 5432). Produção: connection string do Neon.
DATABASE_URL="postgresql://sheep:sheep@127.0.0.1:5433/sheep_portal?schema=public"

# --- Autenticação -----------------------------------------------------------
# Segredo de assinatura da sessão. Gere o seu: openssl rand -base64 32
AUTH_SECRET=""
# URL pública do portal (usada pelo Auth.js). Em dev, http://localhost:3000
AUTH_URL="http://localhost:3000"

# --- Agendador --------------------------------------------------------------
# Token que o cron externo (GitHub Actions) apresenta em POST /api/scheduler/tick.
# Sem ele o endpoint responde 401 — o disparo automático não pode ser público.
SCHEDULER_TOKEN=""

# --- IA (somente SC-01: extração de lançamentos de extrato) -----------------
# Chave da Anthropic. Sem ela, o SC-01 usa apenas os parsers determinísticos
# e manda para conferência o que não conseguir ler.
ANTHROPIC_API_KEY=""

# --- Fronteiras mockadas ----------------------------------------------------
# Nenhum acesso real é concedido: as integrações externas apontam para os
# serviços falsos servidos pelo próprio projeto. É aqui que entraria o real.
# SC-02: portais dos órgãos (situação fiscal)
ORGAOS_BASE_URL="http://localhost:3000/api/_fake/orgaos"
# SC-05: sistemas em que o bloqueio é aplicado
SISTEMAS_BASE_URL="http://localhost:3000/api/_fake/sistemas"
